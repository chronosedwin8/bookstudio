NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173

PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=changeme
PGDATABASE=bookstudio
PG_POOL_MAX=10
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECTION_TIMEOUT_MS=5000

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=12h
JWT_QR_EXPIRES_IN=365d

# --- Phidias (opcional) ---
# Sin estas variables, la importacion de grupos queda desactivada.
PHIDIAS_BASE_URL=https://tu-colegio.phidias.co/rest
PHIDIAS_TOKEN=
PHIDIAS_DEFAULT_PASSWORD=cambiame

# --- Mercado Pago ---
# Sin MP_ACCESS_TOKEN la facturacion queda desactivada.
# El ACCESS_TOKEN y el WEBHOOK_SECRET son secretos: nunca en el repositorio.
APP_URL=https://bookstudio.uk
MP_PUBLIC_KEY=
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_WEBHOOK_URL=https://bookstudio.uk/api/billing/webhook

# --- Cuenta de administracion (solo en el despliegue) ---
# Se revisa en cada arranque del contenedor. Si la cuenta no existe se crea con rol
# admin; si ya existe solo se comprueba que siga siendo admin y su contrasena NO se
# reescribe, para que cambiarla desde la aplicacion sea definitivo.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
