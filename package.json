{
  "name": "bookstudio",
  "private": true,
  "version": "0.1.0",
  "description": "BookStudio - Creador de libros interactivos educativos (100% open source)",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace @bookstudio/api",
    "dev:web": "npm run dev --workspace @bookstudio/web",
    "migrate": "npm run migrate --workspace @bookstudio/api",
    "seed": "npm run seed --workspace @bookstudio/api",
    "red": "powershell -ExecutionPolicy Bypass -File ./scripts/red-local.ps1",
    "red:cert": "powershell -ExecutionPolicy Bypass -File ./scripts/red-local.ps1 -Certificado",
    "red:firewall": "powershell -ExecutionPolicy Bypass -File ./scripts/red-local.ps1 -AbrirFirewall"
  },
  "engines": {
    "node": ">=20"
  }
}
